# ========================================
# VARIÁVEIS DE AMBIENTE - Tsundoku API
# ========================================

# Banco de Dados MySQL
ConnectionStrings__Default=""

# JWT - MUDE EM PRODUÇÃO!
JwtConfiguration__SecretToken=""

# CORS - Origens permitidas
Cors__AllowedOrigins__0="http://localhost:3000"
Cors__AllowedOrigins__1="http://localhost:5173"

# AWS S3 (opcional)
ApiAws__AwsAccessKeyId=""
ApiAws__AwsSecretAccessKey=""
ApiAws__BucketName=""
ApiAws__DistributionId=""
ApiAws__DistributionDomainName=""

# Tinify - Compressão de imagens (opcional)
ApiTinify__ApiKey=""

# Certificados SSL (opcional)
CertificateSettings__Path="TsundokuTraducoes.Helpers/Certificados/aspnetapp.pfx"
CertificateSettings__Password=""

# Logging
Logging__LogLevel__Default="Information"
Logging__LogLevel__Microsoft="Warning"

# Ambiente
ASPNETCORE_ENVIRONMENT="Development"


